            "ergodic-theory/compact-abelian-rotation",
            "ergodic-theory/classical-operator-algebra-dictionary",
            "operator-algebras/fixed-point-algebra",
            "ergodic-theory/fixed-function-ergodicity-criterion"
          ],
          "batch_additions": [],
          "note": ""
        },
        {
          "topic": "Archimedean trace, codifferent, dual basis, all characters, and Fourier completeness",
          "baseline": "covered",
          "existing_coverage": [
            "algebra-fields-galois/archimedean-trace-pairing",
            "algebra-fields-galois/codifferent",
