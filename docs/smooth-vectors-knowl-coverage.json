    {
      "title": "Smooth vectors of a unitary representation",
      "input_sha256": "2e269a994fc4549f6a6187ab117b8b71ac4f9672daff677c33fd8ed9e53992fa",
      "input_characters": 16318,
      "coverage": [
        {
          "topic": "Noncompactness does not force infinite-dimensional irreducibles",
          "baseline": "partly_covered",
          "existing_coverage": [
            "lie-groups/irreducible-unitary-representation",
            "lie-groups/type-i-locally-compact-group"
          ],
          "batch_additions": [
            "lie-groups/noncompact-finite-dimensional-unitary-example"
          ],
          "note": "The trivial example existed; the nontrivial R × SU(2) example is new."
        },
        {
          "topic": "Strong continuity, closed-subspace irreducibility, and weak–strong equivalence",
          "baseline": "covered",
          "existing_coverage": [
            "lie-groups/strongly-continuous-unitary-representation",
            "lie-groups/irreducible-unitary-representation",
            "lie-groups/weak-strong-continuity-equivalence-unitary-representations"
          ],
          "batch_additions": [],
          "note": ""
        },
        {
          "topic": "Smooth orbit maps, density, and finite versus infinite differentiability",
          "baseline": "partly_covered",
          "existing_coverage": [
            "lie-groups/smooth-vector-unitary-representation",
            "lie-groups/garding-density-theorem"
          ],
          "batch_additions": [
            "lie-groups/ck-vector-unitary-representation"
          ],
          "note": "Removed differentiable vector as an alias for smooth vector and linked the finite-order definition."
        },
        {
          "topic": "Operator-norm Banach–Lie group versus vectorwise smoothness",
          "baseline": "missing",
          "existing_coverage": [],
          "batch_additions": [
            "differential-geometry/banach-manifold",
            "lie-groups/banach-lie-group",
            "lie-groups/norm-unitary-group"
          ],
          "note": ""
        },
        {
          "topic": "Derived action, common invariant smooth domain, and commutator identity",
          "baseline": "covered",
          "existing_coverage": [
            "lie-groups/derived-representation-on-smooth-vectors",
            "lie-groups/universal-enveloping-algebra-action-on-smooth-vectors"
          ],
          "batch_additions": [],
          "note": "Explicit real-linearity in X and complex-linearity on vectors added to the existing definition."
        },
        {
          "topic": "Smooth vectors as all finite iterated maximal-generator domains",
          "baseline": "missing",
          "existing_coverage": [
            "lie-groups/infinitesimal-generator-unitary-representation",
            "lie-groups/nelson-laplacian"
          ],
          "batch_additions": [
            "lie-groups/smooth-vectors-iterated-generator-domains"
          ],
          "note": "Generators and the Laplacian formulation existed; the ordered-product characterization is now explicit."
        },
        {
          "topic": "Fréchet topology, basis-independent norms, completeness, and derivative estimates",
          "baseline": "partly_covered",
          "existing_coverage": [
            "lie-groups/distribution-vectors-of-a-representation",
            "functional-analysis/frechet-space"
          ],
          "batch_additions": [
            "lie-groups/smooth-vector-frechet-topology"
          ],
          "note": "Existing seminorm discussion extracted to its own canonical entry and supplemented with the explicit p_k formula and estimate."
        },
        {
          "topic": "Stone generators, essential skew-adjointness, graph closure, and cores",
          "baseline": "covered",
          "existing_coverage": [
            "lie-groups/stone-theorem-one-parameter-unitary-groups",
            "lie-groups/infinitesimal-generator-unitary-representation",
            "lie-groups/essentially-skew-adjoint-derived-operators",
            "functional-analysis/core-of-closed-operator"
          ],
          "batch_additions": [],
          "note": ""
        },
        {
          "topic": "Gårding averaging, approximate identities, and absence of irreducibility/type I assumptions",
          "baseline": "covered",
          "existing_coverage": [
            "harmonic-analysis/integrated-form-unitary-representation",
            "lie-groups/garding-subspace",
            "lie-groups/garding-density-theorem"
          ],
          "batch_additions": [],
          "note": "Existing proof retained; independence from irreducibility and type I made explicit."
        },
        {
          "topic": "Continuous anti-dual, Hilbert embedding, and extended group/Lie-algebra actions",
          "baseline": "partly_covered",
          "existing_coverage": [
            "lie-groups/distribution-vectors-of-a-representation",
            "functional-analysis/strong-dual",
            "functional-analysis/rigged-hilbert-space"
          ],
          "batch_additions": [
            "functional-analysis/continuous-antidual"
          ],
          "note": "The extension formulas existed. Added a reusable anti-dual definition and explicit linear Hilbert embedding using the repository inner-product convention."
        },
        {
          "topic": "Nuclearity iff trace class; type I is insufficient",
          "baseline": "missing",
          "existing_coverage": [
            "functional-analysis/nuclear-space",
            "functional-analysis/trace-class-operator",
            "lie-groups/type-i-locally-compact-group"
          ],
          "batch_additions": [
            "lie-groups/trace-class-representation",
            "lie-groups/nuclear-smooth-vectors-trace-class"
          ],
          "note": ""
        },
        {
          "topic": "Heisenberg group and Schrödinger action in the pasted coordinate convention",
          "baseline": "partly_covered",
          "existing_coverage": [
            "lie-groups/heisenberg-group",
            "mathematical-physics/schrodinger-representation"
          ],
          "batch_additions": [
            "lie-groups/heisenberg-derived-representation"
          ],
          "note": "Existing symmetric/Weyl conventions retained; added c=z+ab/2 conversion and the infinitesimal operators."
        },
        {
          "topic": "Heisenberg smooth vectors are Schwartz space with its usual topology",
          "baseline": "missing",
          "existing_coverage": [
            "functional-analysis/schwartz-space"
          ],
          "batch_additions": [
            "lie-groups/schrodinger-smooth-vectors"
          ],
          "note": ""
        },
        {
          "topic": "Modulation is strongly continuous but norm distance two from identity",
          "baseline": "missing",
          "existing_coverage": [
            "lie-groups/strongly-continuous-unitary-representation"
          ],
          "batch_additions": [
            "lie-groups/modulation-unitary-group"
          ],
          "note": ""
        },
        {
          "topic": "Pointwise smooth square-integrable function that is not a smooth vector",
          "baseline": "missing",
          "existing_coverage": [
            "functional-analysis/schwartz-space"
          ],
          "batch_additions": [
            "lie-groups/schrodinger-smooth-vectors"
          ],
          "note": "Added (1+x²)^(-1/2) and the failure of the modulation-generator domain condition."
        },
        {
          "topic": "Tempered-distribution rigging and anti-linear point evaluation",
          "baseline": "partly_covered",
          "existing_coverage": [
            "functional-analysis/rigged-hilbert-space",
            "functional-analysis/tempered-distribution",
            "functional-analysis/dirac-delta-distribution",
            "lie-groups/distribution-vectors-of-a-representation"
          ],
          "batch_additions": [
            "lie-groups/schrodinger-smooth-vectors"
          ],
          "note": "Made the anti-linear convention consistent and added the point-evaluation distribution-vector example."
        },
        {
          "topic": "Unitary irreducibility need not imply algebraic irreducibility on smooth vectors",
          "baseline": "missing",
          "existing_coverage": [
            "lie-groups/irreducible-unitary-representation",
            "lie-groups/irreducible-representation-lie-algebra"
          ],
          "batch_additions": [
            "lie-groups/heisenberg-derived-representation"
          ],
          "note": "Extended existing algebraic irreducibility/subrepresentation definitions to arbitrary-dimensional modules; kept finite-dimensional hypotheses for Weyl’s theorem."
        },
        {
          "topic": "Derived inverse pullback is minus the Lie derivative",
          "baseline": "missing",
          "existing_coverage": [
            "lie-groups/smooth-action-lie-group",
            "fiber-bundles/lie-derivative",
            "ergodic-theory/koopman-generator"
          ],
          "batch_additions": [
            "lie-groups/fundamental-vector-field-left-action",
            "lie-groups/derived-pullback-representation"
          ],
          "note": ""
        }
      ]
    }
